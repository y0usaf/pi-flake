+function parseReplFenceArguments(code: string): Record<string, unknown> {
+	const trimmed = code.trim();
+	if (!trimmed) return { code: "" };
+	if ((trimmed.startsWith("{") && trimmed.endsWith("}")) || (trimmed.startsWith("[") && trimmed.endsWith("]"))) {
+		try {
+			const parsed = JSON.parse(trimmed);
+			if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
+				if (typeof (parsed as Record<string, unknown>).code === "string") {
+					return parsed as Record<string, unknown>;
+				}
+			}
+		} catch {
+			// Fall through to raw code.
+		}
+	}
+	return { code };
+}
+
+function extractReplFenceArgumentsFromText(text: string): Record<string, unknown>[] {
+	const args: Record<string, unknown>[] = [];
+	const lines = text.split(/\r?\n/);
+	let inFence = false;
+	let fenceLines: string[] = [];
+	let hasVisibleText = false;
+
+	for (const line of lines) {
+		const trimmed = line.trimStart();
+		if (!inFence) {
+			if (trimmed.startsWith("```repl")) {
+				inFence = true;
+				fenceLines = [];
+				continue;
+			}
+			if (line.trim().length > 0) {
+				hasVisibleText = true;
+			}
+			continue;
+		}
+
+		if (trimmed.startsWith("```")) {
+			args.push(parseReplFenceArguments(fenceLines.join("\n")));
+			inFence = false;
+			continue;
+		}
+
+		fenceLines.push(line);
+	}
+
+	if (hasVisibleText) return [];
+	if (inFence) {
+		args.push(parseReplFenceArguments(fenceLines.join("\n")));
+	}
+
+	return args;
+}
+
+function attachReplFenceToolCalls(message: AssistantMessage): AssistantMessage {
+	if (message.role !== "assistant") return message;
+
+	const text = message.content
+		.filter((block) => block.type === "text")
+		.map((block: any) => block.text)
+		.join("\n");
+	const fenceArgs = extractReplFenceArgumentsFromText(text);
+	if (fenceArgs.length === 0) return message;
+
+	const syntheticBlocks = fenceArgs.map((args, index) => ({
+		type: "toolCall",
+		id: `repl:${message.timestamp}:${index}`,
+		name: "repl",
+		arguments: args,
+	} as any));
+
+	return { ...message, content: [...message.content, ...syntheticBlocks] };
+}
 /**
  * Execute tool calls from an assistant message.
  */
