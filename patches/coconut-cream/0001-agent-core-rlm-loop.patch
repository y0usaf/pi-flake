index 000000000000..2e5ce2554ffd
--- /dev/null
+++ b/packages/ai/src/utils/node-http-proxy.ts
@@ -0,0 +1,106 @@
+import type { Agent as HttpAgent } from "node:http";
+import type { Agent as HttpsAgent } from "node:https";
+import { HttpProxyAgent } from "http-proxy-agent";
+import { HttpsProxyAgent } from "https-proxy-agent";
+
+export interface NodeHttpProxyAgents {
+	httpAgent: HttpAgent;
+	httpsAgent: HttpsAgent;
+}
+
+export const UNSUPPORTED_PROXY_PROTOCOL_MESSAGE =
+	"Unsupported proxy protocol. SOCKS and PAC proxy URLs are not supported; use an HTTP or HTTPS proxy URL.";
+
+function envValue(name: string): string | undefined {
+	const value = process.env[name];
+	return typeof value === "string" && value.trim() ? value.trim() : undefined;
+}
+
+function defaultPort(protocol: string): string {
+	switch (protocol) {
+		case "http:":
+		case "ws:":
+			return "80";
+		case "https:":
+		case "wss:":
+			return "443";
+		default:
+			return "";
+	}
+}
+
+function hostMatchesNoProxy(hostname: string, noProxyHost: string): boolean {
+	if (!noProxyHost) return false;
+	if (noProxyHost === "*") return true;
+	const normalized = noProxyHost.replace(/^\*+/, "").toLowerCase();
+	const host = hostname.toLowerCase();
+	if (!normalized) return false;
+	if (normalized.startsWith(".")) {
+		const suffix = normalized.slice(1);
+		return host === suffix || host.endsWith(`.${suffix}`);
+	}
+	return host === normalized || host.endsWith(`.${normalized}`);
+}
+
+function isNoProxy(target: URL): boolean {
+	const raw = envValue("NO_PROXY") ?? envValue("no_proxy");
+	if (!raw) return false;
+	const host = target.hostname;
+	const port = target.port || defaultPort(target.protocol);
+	for (const token of raw.split(/[\s,]+/)) {
+		const entry = token.trim();
+		if (!entry) continue;
+		if (entry === "*") return true;
+		const idx = entry.lastIndexOf(":");
+		const hasPort = idx > 0 && entry.indexOf("]") === -1;
+		const entryHost = hasPort ? entry.slice(0, idx) : entry;
+		const entryPort = hasPort ? entry.slice(idx + 1) : "";
+		if (!hostMatchesNoProxy(host, entryHost)) continue;
+		if (!entryPort || entryPort === port) return true;
+	}
+	return false;
+}
+
+export function getProxyForUrl(targetUrl: string | URL): string {
+	const target = targetUrl instanceof URL ? targetUrl : new URL(targetUrl);
+	if (isNoProxy(target)) return "";
+	const protocol = target.protocol;
+	const proxy = protocol === "https:" || protocol === "wss:"
+		? envValue("HTTPS_PROXY") ?? envValue("https_proxy") ?? envValue("HTTP_PROXY") ?? envValue("http_proxy")
+		: envValue("HTTP_PROXY") ?? envValue("http_proxy") ?? envValue("ALL_PROXY") ?? envValue("all_proxy");
+	return proxy ?? "";
+}
+
+export function resolveHttpProxyUrlForTarget(targetUrl: string | URL): URL | undefined {
+	const proxy = getProxyForUrl(targetUrl);
+	if (!proxy) {
+		return undefined;
+	}
+
+	let proxyUrl: URL;
+	try {
+		proxyUrl = new URL(proxy);
+	} catch (error) {
+		throw new Error(
+			`Invalid proxy URL ${JSON.stringify(proxy)}: ${error instanceof Error ? error.message : String(error)}`,
+		);
+	}
+
+	if (proxyUrl.protocol !== "http:" && proxyUrl.protocol !== "https:") {
+		throw new Error(`${UNSUPPORTED_PROXY_PROTOCOL_MESSAGE} Got ${proxyUrl.protocol}`);
+	}
+
+	return proxyUrl;
+}
+
+export function createHttpProxyAgentsForTarget(targetUrl: string | URL): NodeHttpProxyAgents | undefined {
+	const proxyUrl = resolveHttpProxyUrlForTarget(targetUrl);
+	if (!proxyUrl) {
+		return undefined;
+	}
+
+	return {
+		httpAgent: new HttpProxyAgent(proxyUrl),
+		httpsAgent: new HttpsProxyAgent(proxyUrl) as unknown as HttpsAgent,
+	};
+}
