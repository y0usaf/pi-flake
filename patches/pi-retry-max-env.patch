+/**
+ * Read PI_RETRY_MAX env var, default 0 = essentially infinite retries.
+ * Returns 100_000 as "infinite" since SDK maxRetries must be finite.
+ */
+function resolveMaxRetries(optionsVal: number | undefined): number | undefined {
+	const envRaw = typeof process !== "undefined" ? process.env.PI_RETRY_MAX : undefined;
+	if (envRaw === undefined || envRaw === "" || envRaw === "0") {
+		return optionsVal ?? 100_000;
+	}
+	const n = parseInt(envRaw, 10);
+	const envVal = Number.isFinite(n) && n > 0 ? n : 100_000;
+	return optionsVal ?? envVal;
+}
