+function getDefaultPackageSourcesFromEnv(): PackageSource[] {
+	const raw = process.env[DEFAULT_PACKAGE_SOURCES_ENV];
+	if (!raw?.trim()) return [];
+
+	return raw
+		.split(process.platform === "win32" ? ";" : ":")
+		.map((source) => source.trim())
+		.filter(Boolean);
+}
