{
  "name": "@y0usaf/pi-aphrodite",
  "version": "0.2.0",
  "description": "Pi extension that compresses oversized tool output through an Aphrodite CCR proxy for LLM token savings",
  "keywords": [
    "aphrodite",
    "ccr",
    "pi",
    "pi-coding-agent",
    "pi-package"
  ],
  "homepage": "https://github.com/y0usaf/pi-flake#readme",
  "bugs": {
    "url": "https://github.com/y0usaf/pi-flake/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y0usaf/pi-flake.git"
  },
  "license": "MIT",
  "author": "y0usaf",
  "type": "module",
  "files": [
    "*.ts",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format-check": "prettier --check *.ts",
    "lint": "eslint .",
    "sort-package-json": "npx sort-package-json",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.5.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
