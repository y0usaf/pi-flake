{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["index.ts", "config.ts", "contract.ts", "state.ts", "render.ts", "registry.ts", "spawn.ts", "loop.ts", "orchestrator.ts", "rpc-child.ts"]
}
