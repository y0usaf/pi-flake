{
	"name": "pi-agents",
	"version": "0.5.0",
	"description": "Multi-agent orchestration extension for pi: spawn, delegate to, and kill RPC-subprocess child agents",
	"keywords": [
		"pi-package",
		"pi-extension",
		"multi-agent",
		"typescript"
	],
	"files": [
		"index.ts",
		"config.ts",
		"contract.ts",
		"state.ts",
		"render.ts",
		"registry.ts",
		"spawn.ts",
		"loop.ts",
		"orchestrator.ts",
		"rpc-child.ts",
		"README.md",
		"package.json"
	],
	"type": "module",
	"homepage": "https://github.com/y0usaf/pi-flake/tree/main/extensions/pi-agents",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/y0usaf/pi-flake.git",
		"directory": "extensions/pi-agents"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@sinclair/typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^0.82.0",
		"@earendil-works/pi-ai": "^0.82.0",
		"@earendil-works/pi-coding-agent": "^0.82.0",
		"@earendil-works/pi-tui": "^0.82.0",
		"@sinclair/typebox": "^0.34.33",
		"typescript": "^7.0.2"
	},
	"license": "MIT"
}