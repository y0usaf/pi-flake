{
  "name": "pi-rlm",
  "version": "0.4.0",
  "type": "module",
  "description": "pi extension: single execute tool backed by a persistent Bun TypeScript evaluator with panel/loop/peek orchestration (port replacing pi-js-kernel)",
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "bun",
    "typescript",
    "repl"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test test/",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run lint && bun test test/"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/bun": "^1.3.14",
    "typebox": "^1.3.11",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "private": true
}
